{
  "Version": "2012-10-17",
  "Comment": "The write half. Attach alongside iam-plan-readonly.json only on the identity allowed to fire. Every action here is reversible: stop, scale, throttle, modify, disable. There is no Delete* except DeleteNatGateway, which is the one resource AWS gives no way to stop, and no action against S3, EBS, snapshots, EFS, DynamoDB or backups.",
  "Statement": [
    {
      "Sid": "StopComputeReversibly",
      "Effect": "Allow",
      "Action": [
        "autoscaling:UpdateAutoScalingGroup",
        "ecs:UpdateService",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "eks:UpdateNodegroupConfig"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Env": "CHANGE-ME"
        }
      }
    },
    {
      "Sid": "BlockAndUnblockIngress",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:ModifyListener",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "apigateway:PATCH"
      ],
      "Resource": "*",
      "Comment": "CloudFront and API Gateway are not tag-conditioned: neither carries the resource tags the compute condition relies on, and scoping them is done in the policy file's scope instead."
    },
    {
      "Sid": "NatGatewayOptIn",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNatGateway",
        "ec2:CreateNatGateway",
        "ec2:ReplaceRoute",
        "ec2:CreateRoute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DatabasesOptIn",
      "Effect": "Allow",
      "Action": [
        "rds:StopDBInstance",
        "rds:StartDBInstance",
        "rds:StopDBCluster",
        "rds:StartDBCluster"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteSnapshots",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::CHANGE-ME-ops-bucket/killswitch/*"
    },
    {
      "Sid": "NeverTouchTheData",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:DeregisterImage",
        "rds:DeleteDBInstance",
        "rds:DeleteDBCluster",
        "rds:DeleteDBSnapshot",
        "dynamodb:DeleteTable",
        "elasticfilesystem:DeleteFileSystem",
        "backup:DeleteBackupVault",
        "backup:DeleteRecoveryPoint"
      ],
      "Resource": "*"
    }
  ]
}
